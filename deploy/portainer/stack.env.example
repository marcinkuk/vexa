# Vexa Portainer stack — kopie tylko wartości, bez komentarzy Inline
# W Portainerze: zakładka "Environment" stacka. To NIE jest .env czytany przez
# compose — Portainer wstrzykuje te zmienne jako zmienne środowiskowe
# interpolacji `${...}`.
#
# Generowanie: openssl rand -hex 32

# Wymagane
DB_PASSWORD=
ADMIN_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Opcjonalne
RUNTIME_API_TOKEN=
IMAGE_TAG=v012
DB_NAME=vexa
DB_USER=postgres
MINIO_BUCKET=vexa

# Transkrypcja — bez tego bot nagrywa, ale nie daje tekstu (POST /bots -> 503)
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=

# Adresy publiczne (linki w powiadomieniach/terminalu)
VEXA_PUBLIC_API_URL=http://192.168.1.134:8056
TERMINAL_PUBLIC_URL=http://192.168.1.134:3001

# Limity dla hosta 4 GB
LITE_MEM_LIMIT=2g
STT_MEM_LIMIT=1.5g

# Only for smoke tests (English-only tiny model): COMPOSE_PROFILES=local-stt
COMPOSE_PROFILES=
WHISPER_MODEL=Systran/faster-whisper-tiny.en
