# Portainer stack environment — non-secret settings only.
# Secrets (DB_PASSWORD, ADMIN_TOKEN, MINIO_ACCESS_KEY, MINIO_SECRET_KEY) live
# in the host file /opt/vexa/stack.secrets.env, created by
# sh deploy/portainer/init-host.sh — never here, never in git, never in
# Portainer's database (a git re-scan wipes the stack's project directory).

IMAGE_TAG=v0.12.29
DB_NAME=vexa
DB_USER=postgres
MINIO_BUCKET=vexa
SECCOMP_PROFILE=/opt/vexa/seccomp-userns.json
BIND_ADDR=0.0.0.0
GATEWAY_HOST_PORT=8056
TERMINAL_HOST_PORT=3001
AGENT_HOST_PORT=8100
LITE_MEM_LIMIT=2g

# Adresy publiczne (linki w terminalu/powiadomieniach)
VEXA_PUBLIC_API_URL=http://192.168.1.134:8056
TERMINAL_PUBLIC_URL=http://192.168.1.134:3001

# Transkrypcja — bez tego bot nagrywa, ale nie daje tekstu (POST /bots -> 503).
# Dowolny endpoint zgodny z OpenAI (Groq whisper-large-v3, własny vLLM/Whisper na GPU).
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=

# tylko testy dymne (model angielski): COMPOSE_PROFILES=local-stt
COMPOSE_PROFILES=
WHISPER_MODEL=Systran/faster-whisper-tiny.en
STT_MEM_LIMIT=1.5g
